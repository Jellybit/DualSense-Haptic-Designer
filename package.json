{
  "name": "dualsense-haptic-designer",
  "version": "0.1.0",
  "description": "Design DualSense haptics, adaptive-trigger effects and 'things inside the controller' scenes.",
  "license": "MIT",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "build": "electron-vite build",
    "start": "node scripts/run.mjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "web": "vite --config vite.web.config.ts",
    "web:build": "vite build --config vite.web.config.ts",
    "web:preview": "vite preview --config vite.web.config.ts",
    "dist": "electron-vite build && electron-builder --win portable",
    "dist:dir": "electron-vite build && electron-builder --win dir"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@types/w3c-web-hid": "^1.0.6",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.jellybit.dualsense-haptic-designer",
    "productName": "DualSense Haptic Designer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/main/**",
      "out/preload/**",
      "out/renderer/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "electronDist": "node_modules/electron/dist",
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "${productName} ${version}.exe"
    }
  }
}
